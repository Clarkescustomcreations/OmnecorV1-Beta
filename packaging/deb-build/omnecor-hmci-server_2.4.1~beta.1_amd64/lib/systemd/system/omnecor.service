[Unit]
Description=Omnecor HMCI Backend Server
Documentation=https://omnecor.ai
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omnecor
Group=omnecor
WorkingDirectory=/opt/omnecor/backend
# Launch the built production server (cwd = /opt/omnecor/backend; the bundle
# resolves dist/public and node_modules/@libsql relative to this location).
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=3

# --- Environment -------------------------------------------------------------
Environment=NODE_ENV=production
# Persist all application data (DB, models, keystore, backups) under /var/lib.
Environment=OMNECOR_DATA=/var/lib/omnecor
# Absolute path to the generated Drizzle migrations shipped with the package, so
# the schema is applied on first boot regardless of the working directory.
Environment=MIGRATIONS_DIR=/opt/omnecor/backend/drizzle/migrations
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# JWT_SECRET (and any user overrides) are generated by the postinst on first
# install and loaded from here. The leading "-" makes the file optional so a
# missing file does not block startup during reinstall races.
EnvironmentFile=-/etc/omnecor/omnecor.env
# Air-gapped deployments: cloud AI providers are already blocked in Sovereign
# mode without any flag. ZERO_LOGIN_MODE is intentionally NOT supported here —
# the production server refuses to boot with it set (session-forgery guard).

# --- Hardening ---------------------------------------------------------------
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# Writable state lives only under these paths.
ReadWritePaths=/var/lib/omnecor /var/log/omnecor
StateDirectory=omnecor
LogsDirectory=omnecor

[Install]
WantedBy=multi-user.target
