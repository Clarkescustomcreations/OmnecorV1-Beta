# Normalize line endings: text files use LF in the repo.
* text=auto eol=lf

# Shell / Python scripts must keep LF or they break when executed on Linux
# after being checked out on Windows.
*.sh text eol=lf
*.py text eol=lf
*.mjs text eol=lf

# Windows batch/cmd scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
# Model weights are NOT committed — they ship as GitHub Release assets and are
# fetched at install time via scripts/fetch-valet-model.sh. Marked binary so a
# stray add never gets line-ending normalized (and never re-enters Git LFS).
*.gguf binary
*.onnx binary
*.db binary
*.zip binary
*.apk binary
