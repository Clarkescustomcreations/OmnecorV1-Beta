# ──────────────────────────────────────────────────────────────────────────────
# Omnecor HQ — Mobile App Environment
# Copy to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server connection ─────────────────────────────────────────────────────────
# Tailscale IP of your Omnecor PC  (preferred — works from anywhere)
#   Install Tailscale on PC + phone, join same tailnet, copy the PC's 100.x.x.x IP.
# OR your LAN IP (192.168.x.x) when on the same Wi-Fi.
EXPO_PUBLIC_API_BASE_URL=http://100.64.0.1:3000

# ── OAuth (optional — only needed if using the Manus OAuth portal) ────────────
# Leave blank to skip OAuth and use the server's ZERO_LOGIN_MODE or manual login.
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=

# ── OMMESH ────────────────────────────────────────────────────────────────────
# Must match OMMESH_SECRET in OmnecorV1-Beta/.env on your PC.
# Set via the Settings screen inside the app — does NOT need to be here.
# OMMESH_SECRET=your-shared-secret

# ── Notes ────────────────────────────────────────────────────────────────────
# Server IP and OMMESH secret are stored in the app via AsyncStorage and
# can be changed in Settings without rebuilding the APK.
#
# Ports used by the PC (must be reachable from the phone):
#   3000  — Omnecor main server (tRPC + WebSocket)
#   8001  — Whisper STT server
#   8002  — TTS (Kokoro) server
#
# Tailscale quick-start:
#   1. curl -fsSL https://tailscale.com/install.sh | sh   (on PC)
#   2. Install Tailscale from Play Store on your S25 Ultra
#   3. tailscale up  (on PC)
#   4. tailscale ip  (copy the 100.x.x.x address)
#   5. Enter that IP in the Omnecor HQ Settings screen
