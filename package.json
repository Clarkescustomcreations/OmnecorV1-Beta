  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --bundle --format=esm --outdir=dist --banner:js=\"import { createRequire as __createRequire } from 'module'; const require = __createRequire(import.meta.url);\" --define:process.env.NODE_ENV=\"\\\"production\\\"\" --external:better-sqlite3 --external:onnxruntime-node --external:fsevents --external:vite --external:cohere-ai --external:ollama --external:lightningcss --external:@babel/core --external:@tailwindcss/oxide && node --input-type=commonjs -e \"require('fs').writeFileSync('dist/package.json',JSON.stringify({type:'module'}))\"",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "build:web": "cd packaging/electron-app && pnpm build",
    "build:android": "pnpm build:web && cd packaging/electron-app && pnpm exec cap sync android",
    "valet:fetch": "bash scripts/fetch-valet-model.sh",
    "valet:build": "python3 server/python_bridges/valet_pipeline.py",
    "valet:setup-ml": "bash scripts/setup-valet-ml.sh",
    "valet:repro": "python3 scripts/check_valet_reproducibility.py"
  },
