# Dependencies
**/node_modules
.pnpm-store/

# Node.js compile cache (generated at runtime)
**/node-compile-cache/

# Build outputs
dist/
build/
*.dist

# Demo build artifact — intermediate only; the served copy lives in docs/demo/
dist-demo/

# Exception: Windows installer build assets (static source files, not compile outputs)
!packaging/electron-app/build/
!packaging/electron-app/build/*.ico
!packaging/electron-app/build/*.png

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock
*.bak

# Local SQLite store (Sovereign / offline mode)
/data/
*.db
*.db-shm
*.db-wal

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Database
*.db
*.sqlite
*.sqlite3

# Webdev artifacts (checkpoint zips, migrations, etc.)
.webdev/

# Manus version file (auto-generated, not part of source)
client/public/__manus__/version.json

# Debug artifacts
tsc_output.txt

# Valet Router trained / downloaded model weights (large binaries — never commit)
# current.json and metadata.json are committed; *.gguf and adapter dirs are not.
models/valet-router/*/
*.gguf
_refs/
.claude/worktrees/
