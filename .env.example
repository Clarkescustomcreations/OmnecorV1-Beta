# Omnecor (CORTEX) — Environment Configuration Template
# Copy this file to .env and fill in your local values.

# ---------------------------------------------------------------------------
# Core Server Settings
# ---------------------------------------------------------------------------
# The main port for the unified Express + tRPC server.
PORT=3000

# Omnecor server port (WebSocket shares this port via HTTP upgrade).
OMNECOR_PORT=3000
OMNECOR_WS_PORT=3000
OMNECOR_HOST=0.0.0.0

# CORS allowed origins (comma-separated list).
OMNECOR_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment mode (production, development).
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database & Persistence
# ---------------------------------------------------------------------------
# Omnecor uses a single unified engine: libSQL / SQLite (Drizzle ORM).
#
# Default (no config): an embedded local file database — zero-infra, air-gappable
# Sovereign mode. Every feature works out of the box, no external database.
#
# Networked / multi-node: point at a libsql or Turso endpoint for a shared,
# replicated database. Embedded replicas are also supported by libSQL.
# LIBSQL_URL=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=your-turso-auth-token
# (TURSO_DATABASE_URL / TURSO_AUTH_TOKEN are accepted as aliases.)

# Path to the local SQLite file when running embedded. Defaults to
# ~/.omnecor/data/omnecor.db
# SQLITE_PATH=./data/omnecor.db

# ChromaDB server URL for vector search and long-term memory.
CHROMADB_URL=http://localhost:8000
CHROMA_URL=http://localhost:8000

# Directory for security backups.
OMNECOR_BACKUP_DIR=./backups

# ---------------------------------------------------------------------------
# AI Providers & APIs
# ---------------------------------------------------------------------------
# Primary App ID for OAuth and identification.
VITE_APP_ID=omnecor-local-dev

# JWT Secret for session cookies.
JWT_SECRET=replace_with_a_secure_random_string

# Session lifetime in milliseconds. Defaults to one year (31536000000) for
# local-first / sovereign desktop installs. For any network-accessible
# deployment, set a much shorter value — e.g. 604800000 (7 days).
# SESSION_TTL_MS=604800000

# Forge API (Internal project tools).
BUILT_IN_FORGE_API_URL=https://api.forge.example.com
BUILT_IN_FORGE_API_KEY=your_forge_api_key

# OAuth Configuration.
OAUTH_SERVER_URL=https://auth.example.com
OWNER_OPEN_ID=your_openid_identifier

# (Planned) External AI Providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Ollama local model server
OLLAMA_URL=http://localhost:11434
OLLAMA_BIND_ADDRESS=127.0.0.1
# Proxy auth token (leave empty for local dev — set for network-exposed deployments)
OLLAMA_PROXY_TOKEN=

# ElevenLabs Cloud TTS
# Get your key at https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ---------------------------------------------------------------------------
# Agentic Wallet — Virtual Card Provider (Optional, opt-in)
# ---------------------------------------------------------------------------
# Leave blank to disable virtual card issuance. App functions fully without this.
# LITHIC_API_KEY=your_lithic_api_key_here
# VIRTUAL_CARD_PROVIDER=lithic

# ---------------------------------------------------------------------------
# Specialized Module Bridges (Python)
# ---------------------------------------------------------------------------
# Executable paths for local tools.
PYTHON_BIN=python3
BLENDER_BIN=blender
KICAD_CLI_PATH=kicad-cli

# Whisper & TTS Microservice URLs.
WHISPER_SERVER_URL=http://localhost:8001
TTS_SERVER_URL=http://localhost:8002
RVC_SERVER_URL=http://127.0.0.1:8003

# ---------------------------------------------------------------------------
# Local Python Bridge Ports (optional — change if default ports are in use)
# ---------------------------------------------------------------------------
# Fal AI image/video generation bridge (default: 8004)
# FAL_LOCAL_PORT=8004

# Multi-Agent System (RecursiveMAS) bridge (default: 8011)
# MAS_BRIDGE_PORT=8011

# llama.cpp inference bridge (default: 8013)
# LLAMA_CPP_PORT=8013

# ComfyUI workflow server — set full URL or just the port
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_PORT=8188

# LoRA Fine-tuning output directory.
LORA_OUTPUT_DIR=./lora_outputs
MAX_TRAINING_JOBS=1

# ---------------------------------------------------------------------------
# System Behavior
# ---------------------------------------------------------------------------
# File system watcher debounce interval (ms).
WATCHER_DEBOUNCE_MS=300

# Loop detector threshold (consecutive identical actions before signaling).
LOOP_THRESHOLD=3
LOOP_HISTORY_SIZE=100

# ---------------------------------------------------------------------------
# Frontend (Vite) — Prefixed with VITE_
# ---------------------------------------------------------------------------
# These variables are exposed to the client-side code.
VITE_FRONTEND_FORGE_API_KEY=your_forge_api_key
VITE_FRONTEND_FORGE_API_URL=https://api.forge.example.com
VITE_OAUTH_PORTAL_URL=https://portal.example.com
VITE_WS_URL=ws://localhost:3000/ws

# Absolute path to the project root, used by Command Palette YARA/security scans.
# Defaults to "." (server CWD) if unset — only set this if scans land in the wrong directory.
# VITE_PROJECT_ROOT=/absolute/path/to/omnecor

# Zero-Login / Offline Mode
# WARNING: When enabled, ALL requests are authenticated as a local admin with Sovereign mode.
# NEVER enable this on a network-accessible deployment. For air-gapped/offline use only.
# ZERO_LOGIN_MODE=false

# Social login (OPTIONAL). You do NOT need any of these to use Omnecor — the
# default local account (username + password) works with zero setup, fully
# offline/sovereign, on both the desktop and the Omnecor HQ mobile app.
#
# To enable Google / Microsoft sign-in you do NOT have to edit this file: open
# the app and go to Settings → Social Login, paste your own OAuth app's Client
# ID + Secret (stored encrypted in ~/.omnecor/settings.json, never committed),
# and copy the redirect URIs shown there into the Google Cloud / Azure console.
# These env vars are just an alternative for headless/automated deploys.
#
# Google OAuth (leave blank to disable Google login)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth (leave blank to disable Microsoft login)
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ---------------------------------------------------------------------------
# OMMESH (Distributed AI Mesh — Phase 9)
# ---------------------------------------------------------------------------
# (Optional) Configuration for local LAN node discovery.
OMMESH_ENABLED=true
OMMESH_NODE_NAME=omnecor-node-01
OMMESH_SECRET=replace_with_mesh_shared_secret

# ---------------------------------------------------------------------------
# Additional AI Providers
# ---------------------------------------------------------------------------
# xAI (Grok)
# XAI_API_KEY=your_xai_api_key_here

# Google Gemini (separate from Google OAuth)
# GEMINI_API_KEY=your_gemini_api_key_here

# Fal.ai (image/video generation)
# FAL_KEY=your_fal_api_key_here

# OpenArt (unified image generation)
# OPENART_API_KEY=your_openart_api_key_here

# Notion integration
# NOTION_CLIENT_ID=your_notion_client_id
# NOTION_CLIENT_SECRET=your_notion_client_secret

# Slack integration
# SLACK_CLIENT_ID=your_slack_client_id
# SLACK_CLIENT_SECRET=your_slack_client_secret

# Social Media OAuth (for Agent Networking)
# Twitter/X
# TWITTER_CLIENT_ID=your_twitter_client_id
# TWITTER_CLIENT_SECRET=your_twitter_client_secret

# LinkedIn
# LINKEDIN_CLIENT_ID=your_linkedin_client_id
# LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Instagram
# INSTAGRAM_CLIENT_ID=your_instagram_client_id
# INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret

# TikTok
# TIKTOK_CLIENT_ID=your_tiktok_client_id
# TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Facebook
# FACEBOOK_CLIENT_ID=your_facebook_client_id
# FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# YouTube
# YOUTUBE_CLIENT_ID=your_youtube_client_id
# YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# Cloud Storage OAuth (for file browser / cloud provider integrations)
# Redirect URI to register with each provider:
#   {PUBLIC_URL}/api/oauth/callback/google_drive
#   {PUBLIC_URL}/api/oauth/callback/dropbox
#   {PUBLIC_URL}/api/oauth/callback/onedrive

# Google Drive (scope: drive.file). Separate credentials from Google login.
# GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id
# GOOGLE_DRIVE_CLIENT_SECRET=your_google_drive_client_secret

# Dropbox (scope: files.content.read)
# DROPBOX_CLIENT_ID=your_dropbox_client_id
# DROPBOX_CLIENT_SECRET=your_dropbox_client_secret

# OneDrive / Microsoft Graph (scope: Files.Read.All)
# ONEDRIVE_CLIENT_ID=your_onedrive_client_id
# ONEDRIVE_CLIENT_SECRET=your_onedrive_client_secret

# n8n workflow automation URL
N8N_URL=http://localhost:5678

# AgenticOS API key for MCP server directory
# AGENTICOS_API_KEY=your_agenticos_api_key_here

# Valet Router inference service URL (runs locally on port 8010)
VALET_ROUTER_URL=http://127.0.0.1:8010
# Valet GGUF serving tunables (llama-cpp-python). n_ctx must exceed the ~3.5k-token
# system prompt + routing manifest; GPU_LAYERS=-1 offloads all layers to GPU
# (auto-falls back to CPU on CPU-only builds), 0 forces CPU.
# VALET_N_CTX=4096
# VALET_GPU_LAYERS=-1
# Generic llama.cpp bridge tunables (port 8013).
# LLAMACPP_N_CTX=2048
# LLAMACPP_GPU_LAYERS=-1

# ---------------------------------------------------------------------------
# Hardware Integration — PCBWay Manufacturing (Optional, opt-in)
# ---------------------------------------------------------------------------
# Leave blank to disable PCBWay quote/order features.
# PCBWAY_API_KEY=your_pcbway_api_key_here
# PCBWAY_PARTNER_ID=your_pcbway_partner_id

# ---------------------------------------------------------------------------
# Security & Threat Intelligence
# ---------------------------------------------------------------------------
# MISP self-hosted instance URL (opt-in IoC feed)
# MISP_URL=https://your-misp-instance.internal
# MISP_API_KEY=your_misp_api_key

# YARA rules directory for threat_scanner.py (optional)
# YARA_RULES_PATH=/opt/omnecor/rules/

# ---------------------------------------------------------------------------
# Python Bridge Configuration
# ---------------------------------------------------------------------------
# Whisper STT settings
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# TTS settings
TTS_DEVICE=cpu
# TTS_OUTPUT_DIR=/tmp/omnecor_tts
TTS_STREAM_RESPONSE=true

# RVC voice conversion
# RVC_MODELS_DIR=assets/models/rvc
# RVC_HUBERT_PATH=assets/hubert_base.pt

# ---------------------------------------------------------------------------
# Auto-Update
# ---------------------------------------------------------------------------
# GitHub repo slug to check for releases (format: owner/repo)
UPDATE_CHECK_REPO=Omnecor/omnecor-hmci
